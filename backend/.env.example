# ==========================================
# 1. CORE SERVER & DATABASE CONFIGURATION
# ==========================================
CORE_ENV=production
CORE_PROJECT_NAME=CORE API
DATABASE_URL=postgresql://user:password@host:port/database

# Allowed frontend URLs for CORS (comma-separated)
CORE_ALLOWED_ORIGINS=https://your-frontend-domain.com

# ==========================================
# 2. AUTHENTICATION & SECURITY KEYS
# ==========================================
# Generate a strong 64+ char random secret in production
SECRET_KEY=

# Set false in production
CORE_ALLOW_DEV_PASSWORDLESS_LOGIN=false

# Firebase Admin service account. Prefer FIREBASE_SERVICE_ACCOUNT_FILE in
# hosted environments; Render secret files are mounted under /etc/secrets.
# Use exactly one of the following values.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_FILE=

# Token expiration (optional defaults)
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHMS=HS256,ES256,RS256

# ==========================================
# 3. AI SERVICES & API KEYS
# ==========================================
AI_ENABLED=true
AI_API_KEY=
AI_MODEL=claude-3-5-sonnet-20241022

# ==========================================
# 4. NOTIFICATION RULES
# ==========================================
NOTIFICATION_DEADLINE_WARNING_HOURS=48
NOTIFICATION_ESCALATION_HOURS_DEFAULT=96
NOTIFICATION_ESCALATION_HOURS_HIGH_PRIORITY=24
